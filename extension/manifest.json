{
  "manifest_version": 3,
  "name": "Job Fit Analyzer Companion",
  "version": "1.0.1",
  "description": "Companion para análise de compatibilidade de vagas de emprego usando IA diretamente do navegador.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png",
    "512": "assets/icon-512.png"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://job-fit-analyzer.web.app/*",
    "https://job-fit-analyzer.firebaseapp.com/*",
    "https://job-fit-analyzer-4f7af.web.app/*",
    "https://job-fit-analyzer-4f7af.firebaseapp.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "extension/sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Painel Job Fit",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://job-fit-analyzer.web.app/*",
      "https://job-fit-analyzer.firebaseapp.com/*",
      "https://job-fit-analyzer-4f7af.web.app/*",
      "https://job-fit-analyzer-4f7af.firebaseapp.com/*",
      "http://localhost/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-fit-analyzer.web.app/*",
        "https://job-fit-analyzer.firebaseapp.com/*",
        "https://job-fit-analyzer-4f7af.web.app/*",
        "https://job-fit-analyzer-4f7af.firebaseapp.com/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
